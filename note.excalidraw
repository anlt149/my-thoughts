      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Partial Application\n- Derive a new function from an existing one by fixing some values\n- The number of fixed params defines the arity of the new function\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
